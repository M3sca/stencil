{
  "name": "stencil",
  "version": "0.1.0",
  "description": "A minimal template engine written in Rust, with Node.js bindings",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "stencil",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --features node",
    "test": "node --test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8"
  },
  "private": true
}
